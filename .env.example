# Copy to .env (run `make init`), then tweak as you like.
# .env is the single source of truth — Compose, pgAdmin, and Garage all read it.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb

# Host ports published on localhost
PGPORT=5432
PGADMIN_PORT=8080

# pgAdmin web login
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Your app connects with (see `make url`):
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${PGPORT}/${POSTGRES_DB}?sslmode=disable

# --- garage (S3-compatible object storage) ---
# Local-dev defaults. Change these for anything that isn't a throwaway.
GARAGE_REGION=garage          # source of truth — garage.toml's s3_region is rendered from this
GARAGE_BUCKET=appbucket
GARAGE_KEY_NAME=app
GARAGE_ACCESS_KEY_ID=GKbae60dd5843d5b30117ddbcf
GARAGE_SECRET_ACCESS_KEY=38915deec1449beb4fb62f2fd79ce55e7820343909ea59cda6321ac0259e4511
GARAGE_RPC_SECRET=0df560a2461ccbb67bf2dd13fd547d2c99f7873fe492bcc93568a0fd62435c2b
GARAGE_ADMIN_TOKEN=6763808f81e63be9cf740081e9a72089

# Host ports
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_UI_PORT=3909
