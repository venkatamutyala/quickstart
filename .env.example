# Copy to .env via `make init` (which also fills every __GEN__ with a random secret).
# .env is gitignored. Deployed secrets come from GitHub Actions/Environment secrets, never here.
# Keep comments on their own lines — some tools fold trailing "# ..." into the value.

# --- Postgres ---
POSTGRES_USER=poc
POSTGRES_PASSWORD=__GEN__
POSTGRES_DB=poc

# --- Valkey ---
VALKEY_PASSWORD=__GEN__

# --- pgAdmin (dev tool; profile: tools) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=__GEN__

# --- Observability (profile: observability). OTLP contract is language-agnostic. ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=poc-app
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=poc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Default OFF so `make up-lean` (no collector) never hangs on export retries.
# `make up` overrides this to false (it starts the lgtm collector).
OTEL_SDK_DISABLED=true
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Exposure (profile: expose; only needed for `make expose`) ---
# Your bare VPS public IP, and the sslip.io hostname derived from it (ip with dashes).
# Example: TUNNEL_VPS_HOST=203.0.113.10  ->  EXPOSE_HOST=203-0-113-10.sslip.io
TUNNEL_VPS_HOST=
TUNNEL_VPS_USER=root
EXPOSE_HOST=
