# Copy to .env (run `make init`), then tweak as you like.
# .env is the single source of truth — Compose, pgAdmin, and Garage all read it.
# Keep comments on their own lines: an inline comment after a value (VAR=x  # ...) leaks
# trailing whitespace into the value under Make/Compose parsing.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb

# Host ports published on localhost
PGPORT=5432
PGADMIN_PORT=8080

# pgAdmin account (desktop mode auto-logs in as this user; no login prompt)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Your app connects with (see `make conn`):
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${PGPORT}/${POSTGRES_DB}?sslmode=disable

# --- garage (S3-compatible object storage) ---
# Local-dev defaults. Change these for anything that isn't a throwaway.
# GARAGE_REGION is the source of truth; garage.toml's s3_region is rendered from it.
GARAGE_REGION=garage
GARAGE_BUCKET=appbucket
GARAGE_KEY_NAME=app
GARAGE_ACCESS_KEY_ID=GKbae60dd5843d5b30117ddbcf
GARAGE_SECRET_ACCESS_KEY=38915deec1449beb4fb62f2fd79ce55e7820343909ea59cda6321ac0259e4511
GARAGE_RPC_SECRET=0df560a2461ccbb67bf2dd13fd547d2c99f7873fe492bcc93568a0fd62435c2b
GARAGE_ADMIN_TOKEN=6763808f81e63be9cf740081e9a72089

# Host ports
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_UI_PORT=3909

# --- valkey (Redis-compatible cache) ---
# VALKEY_PASSWORD is a secret (enforced by Compose). Auth user is the built-in 'default'.
VALKEY_PASSWORD=valkey
VALKEY_PORT=6379
VALKEY_UI_PORT=8081

# --- rabbitmq (AMQP message broker) ---
# RABBITMQ_PASSWORD is a secret (enforced); RABBITMQ_USER is plain config.
# RABBITMQ_PORT is AMQP; RABBITMQ_MANAGEMENT_PORT is the management web UI.
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbit
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- kafka (event-streaming broker) ---
# Single-node KRaft (no ZooKeeper), plaintext — no auth, so there's no secret to enforce.
# KAFKA_PORT is the broker (host clients connect to localhost:${KAFKA_PORT}); KAFKA_UI_PORT
# is the kafbat web UI.
KAFKA_PORT=9092
KAFKA_UI_PORT=8082
# Topics to PRE-create on every `make up` via scripts/kafka-init.sh (idempotent — existing
# topics are left as-is). Comma-separated; each entry is `name` or `name:partitions`;
# replication factor is always 1 (single node — see README). Empty by default: the broker
# auto-creates topics on first use (KAFKA_AUTO_CREATE_TOPICS_ENABLE in docker-compose.yaml)
# and apps can declare them via the AdminClient. Set this only to guarantee specific topics.
KAFKA_TOPICS=
# Default partition count for entries above that don't specify one (name without :partitions).
KAFKA_DEFAULT_PARTITIONS=1

# --- opensearch (search / analytics engine) ---
# Single-node, security plugin DISABLED (plaintext http, no auth) — local-dev only, so
# there's no secret to enforce. OPENSEARCH_PORT is the REST API; OPENSEARCH_DASHBOARDS_PORT
# is the Dashboards web UI. OPENSEARCH_HEAP sizes the JVM (min=max, e.g. 512m).
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_HEAP=512m
